#!/bin/sh
# Make traffic from each virtual camera's IP leave through its own interface, so every virtual
# camera answers from a distinct IP/MAC. Edit the interface:table pairs to match your setup.
PAIRS="${PAIRS:-eth1:101 eth2:102}"
GW=$(ip route show default dev eth0 | awk '{print $3; exit}')
for pair in $PAIRS; do
  IF=${pair%%:*}; T=${pair##*:}
  ip link show "$IF" >/dev/null 2>&1 || continue
  for i in $(seq 1 30); do IP=$(ip -4 -o addr show "$IF" | awk '{print $4}' | cut -d/ -f1); [ -n "$IP" ] && break; sleep 2; done
  [ -z "$IP" ] && continue
  NET=$(ip -4 route show dev "$IF" scope link | awk '{print $1; exit}')
  while ip rule del table "$T" 2>/dev/null; do :; done
  ip route flush table "$T" 2>/dev/null || true
  ip route add "$NET" dev "$IF" src "$IP" table "$T"
  ip route add default via "$GW" dev "$IF" table "$T"
  ip rule add from "$IP" table "$T" priority $((900 + T))
done
