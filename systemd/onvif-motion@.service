[Unit]
Description=Video motion detection for go2rtc stream %i (sends ONVIF motion via onvif-server)
After=go2rtc.service onvif-server.service
Wants=go2rtc.service onvif-server.service

[Service]
User=onvif
Group=onvif
SupplementaryGroups=render
EnvironmentFile=/etc/default/onvif-motion
ExecStart=/bin/sh -c "exec /usr/bin/python3 /opt/onvif-motion/motion.py %i \"$CAMERA_%i\""
Restart=always
RestartSec=10
Nice=5
StateDirectory=onvif-motion/%i

[Install]
WantedBy=multi-user.target
